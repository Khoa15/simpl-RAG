# Copy to .env and replace every value. Never commit .env.
REDIS_PASSWORD=change-me-redis-password
QDRANT_API_KEY=change-me-qdrant-api-key
# At least 32 random characters. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars

# gemini (production: needs GOOGLE_API_KEY) or local (FastEmbed model, no API key needed)
EMBEDDING_PROVIDER=gemini
GOOGLE_API_KEY=
WORKER_CONCURRENCY=2
